{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/regime_snapshot.schema.v1.json",
  "title": "RegimeSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "as_of_ts",
    "session",
    "engine_version",
    "universe",
    "benchmarks",
    "market_phase",
    "trend_regime",
    "vol_regime",
    "risk_tone",
    "confidence",
    "reasoning",
    "signal_votes",
    "metrics_snapshot",
    "regime_changed",
    "change_reason",
    "change_drivers"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "minLength": 8,
      "description": "Unique identifier for this snapshot."
    },
    "as_of_ts": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp for the snapshot."
    },
    "session": {
      "type": "string",
      "enum": [
        "premarket",
        "open",
        "midday",
        "close",
        "afterhours"
      ],
      "description": "Market session when the snapshot was computed."
    },
    "engine_version": {
      "type": "string",
      "description": "Version tag for the regime engine, e.g., regime_v1."
    },
    "universe": {
      "type": "string",
      "const": "US_EQ_ETF",
      "description": "Universe identifier."
    },
    "benchmarks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Benchmark symbols used for regime calculation."
    },
    "market_phase": {
      "type": "string",
      "enum": [
        "trend_up",
        "trend_down",
        "range",
        "transition"
      ],
      "description": "Single compact phase label used for strategy gating."
    },
    "trend_regime": {
      "type": "string",
      "enum": [
        "trend_up",
        "trend_down",
        "range"
      ],
      "description": "Directional trend regime."
    },
    "vol_regime": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high"
      ],
      "description": "Volatility regime."
    },
    "risk_tone": {
      "type": "string",
      "enum": [
        "risk_on",
        "neutral",
        "risk_off"
      ],
      "description": "Risk tone based on credit/equity risk proxies."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Confidence score from 0 to 100."
    },
    "reasoning": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 200
      },
      "minItems": 3,
      "maxItems": 5,
      "description": "Short evidence bullets explaining the regime."
    },
    "signal_votes": {
      "$ref": "#/$defs/SignalVotes"
    },
    "metrics_snapshot": {
      "$ref": "#/$defs/MetricsSnapshot"
    },
    "regime_changed": {
      "type": "boolean",
      "description": "True if the regime label changed versus the prior snapshot."
    },
    "change_reason": {
      "type": "string",
      "minLength": 3,
      "maxLength": 240,
      "description": "Short human-readable explanation of the change."
    },
    "change_drivers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "trend_vote_shift",
          "vol_vote_shift",
          "risk_vote_shift",
          "breadth_shift",
          "credit_shift",
          "signal_disagreement",
          "recent_change_window",
          "market_phase_shift"
        ]
      },
      "uniqueItems": true,
      "description": "Machine-readable drivers behind the change."
    },
    "inputs_hash": {
      "type": "string",
      "description": "Optional hash of normalized inputs for traceability."
    },
    "prev_snapshot_ref": {
      "type": [
        "string",
        "null"
      ],
      "description": "Reference to the prior snapshot id if available."
    }
  },
  "$defs": {
    "SignalVotes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trend",
        "vol",
        "risk"
      ],
      "properties": {
        "trend": {
          "$ref": "#/$defs/TrendSignalVote"
        },
        "vol": {
          "$ref": "#/$defs/VolSignalVote"
        },
        "risk": {
          "$ref": "#/$defs/RiskSignalVote"
        }
      }
    },
    "TrendSignalVote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vote",
        "score",
        "threshold",
        "passed"
      ],
      "properties": {
        "vote": {
          "type": "string",
          "enum": [
            "trend_up",
            "trend_down",
            "range"
          ]
        },
        "score": {
          "type": "number"
        },
        "threshold": {
          "type": "number"
        },
        "passed": {
          "type": "boolean"
        }
      }
    },
    "VolSignalVote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vote",
        "score",
        "threshold",
        "passed"
      ],
      "properties": {
        "vote": {
          "type": "string",
          "enum": [
            "low",
            "normal",
            "high"
          ]
        },
        "score": {
          "type": "number"
        },
        "threshold": {
          "type": "number"
        },
        "passed": {
          "type": "boolean"
        }
      }
    },
    "RiskSignalVote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vote",
        "score",
        "threshold",
        "passed"
      ],
      "properties": {
        "vote": {
          "type": "string",
          "enum": [
            "risk_on",
            "neutral",
            "risk_off"
          ]
        },
        "score": {
          "type": "number"
        },
        "threshold": {
          "type": "number"
        },
        "passed": {
          "type": "boolean"
        }
      }
    },
    "MetricsSnapshot": {
      "type": "object",
      "required": [
        "vote_disagreement_score",
        "recent_change_window_days"
      ],
      "properties": {
        "vote_disagreement_score": {
          "type": "number",
          "description": "Aggregate disagreement score across signal votes."
        },
        "recent_change_window_days": {
          "type": "integer",
          "minimum": 0,
          "description": "Days since last regime change (used for recent change checks)."
        }
      },
      "additionalProperties": true
    }
  }
}
