{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/regime_prices_meta.schema.v1.json",
  "title": "RegimePricesMeta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "provider_version",
    "adapter_version",
    "endpoint",
    "request_canonical",
    "cache_key",
    "symbol",
    "start",
    "end",
    "date_semantics",
    "rounding_mode",
    "rows",
    "source_hash",
    "normalized_csv_hash",
    "cache_hit"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "provider": { "type": "string", "const": "polygon" },
    "provider_version": { "type": "string" },
    "adapter_version": { "type": "string" },
    "endpoint": { "type": "string" },
    "request_canonical": { "type": "string" },
    "cache_key": { "type": "string" },
    "symbol": { "type": "string" },
    "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "end": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "date_semantics": { "type": "string" },
    "rounding_mode": { "type": "string" },
    "rows": { "type": "integer" },
    "source_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "normalized_csv_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "cache_hit": { "type": "boolean" }
  }
}
